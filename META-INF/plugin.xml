<idea-plugin>
  <id>org.bouh.nord.jetbrains</id>
  <name>Nord Darker</name>
  <version>0.14.0-darker</version>
  <vendor email="development@arcticicestudio.com" url="https://www.arcticicestudio.com">Arctic Ice Studio</vendor>

  <description>
    <![CDATA[
      An arctic, north-bluish clean and elegant JetBrains IDE UI and editor color theme.
    ]]>
  </description>

  <change-notes>
    <![CDATA[
      <h3>0.14.0</h3>
      <ul>
        <li>Add the "Nord Darker Islands" theme, based on the Islands Dark UI (IntelliJ 2025.3+).</li>
      </ul>
    ]]>
  </change-notes>

  <!-- See http://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/build_number_ranges.html for details.-->
  <idea-version since-build="191.0"/>

  <!--
  See http://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html on how to target
  different products
  Using `com.intellij.modules.lang` enables support for all products.
  -->
  <depends>com.intellij.modules.lang</depends>

  <extensions defaultExtensionNs="com.intellij">
    <themeProvider id="12345678-9123-4567-8a73-14af69073eae" path="/nord.theme.json"/>
    <themeProvider id="5c1e0d2a-7f3b-4e8a-9b61-2d4f8a73c0e1" path="/nord-islands.theme.json"/>
  </extensions>

  <actions>

  </actions>

</idea-plugin>
